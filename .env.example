# Firebase web configuration for the MangaPlus project already used by the app.
# Copy the values from the existing Firebase project (Project settings → Your apps).
# These are public client identifiers, but they are kept out of version control.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Canonical site URL used in email action links and the generated sitemap.
# Example: https://mangaplus.example
VITE_SITE_URL=
